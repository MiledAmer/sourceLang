URL_Project: C:\\MALIKA\\L3INFO\\PFE\\sourceLang\\malika\\HTML_Parser\\test
URL_File: C:\\MALIKA\\L3INFO\\PFE\\sourceLang\\malika\\HTML_Parser\\index.html


<program> ::= <element> 
            | <import_instructions> <element>

<element> ::= "COMPONENT" IDENTIFIER "(" <parameters> ")" <function>
            | ε

<parameters> ::= ε
               | <parameter>
               | <parameter> "," <parameters>

<parameter> ::= IDENTIFIER ":" IDENTIFIER

<function> ::= "{" <function_body> "}"

<function_body> ::= ε
                  | <instructions>

<instructions> ::= <instruction>
                 | <instruction> <instructions>

<instruction> ::= <type_instruction>
                | <variable_instruction>
                | <return_instruction>

<type_instruction> ::= "TYPE" IDENTIFIER "=" "{" <type_properties> "}" ";"

<type_properties> ::= <type_properties> <type_property>
                    | <type_property>

<type_property> ::= IDENTIFIER ":" IDENTIFIER ";"

<return_instruction> ::= "RETURN" "(" <html_content> ")" ";"

<field_value_list> ::= "{" <field_values> "}"
                     | "{" "}"

<field_values> ::= <field_values> "," <field_value>
                 | <field_value>

<field_value> ::= IDENTIFIER ":" <value>

<value> ::= STRING_LITERAL
          | NUMBER_LITERAL
          | BOOLEAN_LITERAL
          | IDENTIFIER

<variable_instruction> ::= IDENTIFIER ":" IDENTIFIER "=" <field_value_list> ";"
                         | IDENTIFIER ":" IDENTIFIER "=" <value> ";"
                         | IDENTIFIER ":" IDENTIFIER "[" "]" "=" "[" <array_values> "]" ";"
                         | IDENTIFIER ":" IDENTIFIER "[" "]" "=" "[" <custom_type_array_elements> "]" ";"
                         | IDENTIFIER ":" IDENTIFIER ";"

<array_values> ::= <array_value>
                 | <array_values> "," <array_value>

<array_value> ::= NUMBER_LITERAL
                | STRING_LITERAL
                | BOOLEAN_LITERAL
                | IDENTIFIER

<custom_type_array_elements> ::= <custom_type_object>
                              | <custom_type_array_elements> "," <custom_type_object>

<custom_type_object> ::= "{" <field_values> "}"

<identifiant_interpole> ::= IDENTIFIER
                          | IDENTIFIER "." IDENTIFIER
                          | IDENTIFIER "[" NUMBER_LITERAL "]"
                          | IDENTIFIER "[" NUMBER_LITERAL "]" "." IDENTIFIER

<import_instructions> ::= <import_instructions> <import_instruction>
                       | <import_instruction>

<import_instruction> ::= "IMPORT" IDENTIFIER "FROM" STRING_LITERAL ";"

<html_content> ::= ε
                 | <html_content> <html_element>
                 | <html_content> <html_inner>
                 | <html_element>

<html_element> ::= "<" IDENTIFIER <attributes> ">" <html_content> "</" IDENTIFIER ">"
                 | "<" IDENTIFIER <attributes> "/>"
                 | "<" IDENTIFIER <props_list> ">" <html_content> "</" IDENTIFIER ">"
                 | "<" IDENTIFIER <props_list> "/>"
                 | <html_inner>

<attributes> ::= ε
               | <attribute> <attributes>

<attribute> ::= IDENTIFIER "=" STRING_LITERAL

<props_list> ::= ε
               | <prop> <props_list>

<prop> ::= IDENTIFIER "=" "{" <identifiant_interpole> "}"

<html_inner> ::= IDENTIFIER
               | "{" <identifiant_interpole> "}"